rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a group is deleted
    function isGroupDeleted(groupId) {
      return exists(/databases/$(database)/documents/deleted_groups/$(groupId));
    }

    // User profiles (allow authenticated users to read emails for contact matching)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // User private data subcollections (prevent writing groups if deleted via tombstones)
    match /users/{userId}/groups/{groupId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && !isGroupDeleted(groupId);
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Shared groups (accessible by authenticated members, blocked if deleted)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && !isGroupDeleted(groupId);
      allow delete: if request.auth != null;
    }
    match /deleted_groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
